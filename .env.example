# Database Connections Configuration Template
# Copy this file to .env and fill in your passwords/keys.

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# PostgreSQL / Relational Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=northwind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Google Cloud BigQuery
GOOGLE_APPLICATION_CREDENTIALS=jsonkeybq.json
BIGQUERY_PROJECT_ID=mainpro-507007
BIGQUERY_DATASET=public

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=your_database

# Gemini API
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MAX_RETRIES=3

# MongoDB Document Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=analytics

# Local Ollama Configuration (for Routing & Query Generation)
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

