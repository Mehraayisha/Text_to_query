# ==============================================================================
# Text_to_query: Unified Database & LLM Configuration Template
# Copy this file to .env and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neo4j Graph Database
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://demo.neo4jlabs.com
NEO4J_USER=northwind
NEO4J_PASSWORD=northwind
NEO4J_DATABASE=northwind

# ------------------------------------------------------------------------------
# 2. Google Cloud BigQuery
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=jsonkeybq.json
BIGQUERY_BILLING_PROJECT=your-gcp-project-id
BIGQUERY_TARGET_PROJECT=bigquery-public-data
BIGQUERY_DATASET=thelook_ecommerce

# ------------------------------------------------------------------------------
# 3. MongoDB Document Database
# ------------------------------------------------------------------------------
MONGODB_CONNECTION_TYPE=direct
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sample_mflix

# ------------------------------------------------------------------------------
# 4. LLM Providers
# ------------------------------------------------------------------------------
# Local Ollama Configuration (Used by BigQuery & Neo4j Text-to-Query engines)
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1

# OpenAI / OpenRouter Configuration (Used by MongoDB Agent & REST API)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openrouter-or-openai-api-key
OPENAI_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Text_to_query Platform

# ------------------------------------------------------------------------------
# 5. Platform Server Settings
# ------------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEV_MODE=true
SEMANTIC_MODEL_PATH=mongodb/semantic_models
VECTOR_DB=local
