# ===========================================
# MongoDB NL Query AI Agent - Configuration
# ===========================================

ENVIRONMENT=dev
DEV_MODE=true

# ===========================================
# LLM Provider Configuration
# ===========================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openrouter_or_openai_api_key
OPENAI_MODEL=openrouter/free
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=MongoDB NL Query AI Agent

# ===========================================
# MongoDB Connection
# ===========================================
MONGODB_CONNECTION_TYPE=direct
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=sample_mflix

# ===========================================
# Semantic Models & Schema Discovery
# ===========================================
VECTOR_DB=local
SEMANTIC_MODEL_PATH=./semantic_models
MAX_SCHEMA_FIELDS=30

# ===========================================
# Server Settings
# ===========================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
